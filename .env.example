# NeuroGrip environment overrides.
#
# Every key in the TOML configuration can be overridden from the environment using
# the prefix NEUROGRIP__ and a double underscore as the section separator.
# Values are parsed as TOML scalars (so `true`, `12`, `1.5`, `"text"` all work).
#
#   [emg]                          ->  NEUROGRIP__EMG__SAMPLE_RATE_HZ=1000
#   sample_rate_hz = 1000
#
# Copy to `.env` and adjust. `.env` is loaded by scripts/run_*.sh, never by the
# application itself (the application only reads the real process environment).

# ---------------------------------------------------------------------------
# Profile selection
# ---------------------------------------------------------------------------
NEUROGRIP_CONFIG=config/simulation.toml
NEUROGRIP_PROFILE=default

# ---------------------------------------------------------------------------
# Hardware wiring
# ---------------------------------------------------------------------------
# NEUROGRIP__SERVO__PORT="/dev/ttyUSB0"
# NEUROGRIP__SERVO__BAUD=921600
# NEUROGRIP__EMG__PORT="/dev/ttyACM0"
# NEUROGRIP__CAMERA__DEVICE=0

# ---------------------------------------------------------------------------
# Vision
# ---------------------------------------------------------------------------
# NEUROGRIP__VISION__BACKEND="hggd_mcu"
# NEUROGRIP__VISION__MODEL_PATH="models/hggd_mcu/hggd_mcu_int8.onnx"

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# NEUROGRIP__LOGGING__LEVEL="DEBUG"
# NEUROGRIP__UI__RENDERER="text"
